<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/velvetBg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Chip Stack HUD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_bj_chips_a"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_bj_chips_b"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="?attr/velvetAccent"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Current Hand Stake Banner -->
        <TextView
            android:id="@+id/tv_bj_stake_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_velvet"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="?attr/velvetAccent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Tabletop Card Arena -->
        <LinearLayout
            android:id="@+id/card_bj_table"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_velvet_glow"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_bj_hand_a_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:textAllCaps="true"
                android:textColor="?attr/velvetTextMuted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_bj_hand_a_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="serif"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="?attr/velvetAccentStroke" />

            <TextView
                android:id="@+id/tv_bj_hand_b_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:textAllCaps="true"
                android:textColor="?attr/velvetAccent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_bj_hand_b_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="serif"
                android:textColor="?attr/velvetAccent"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_bj_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:textColor="?attr/velvetTextPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Active Turn Controls -->
        <LinearLayout
            android:id="@+id/layout_bj_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_bj_hit"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:backgroundTint="?attr/velvetPrimary"
                    android:text="@string/bj_btn_hit"
                    android:textColor="?attr/velvetTextPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_bj_stand"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/bj_btn_stand"
                    android:textColor="?attr/velvetTextPrimary" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_bj_double"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="@string/bj_btn_double" />
        </LinearLayout>

        <!-- Showdown Controls -->
        <LinearLayout
            android:id="@+id/layout_bj_showdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_bj_claim_dare"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="?attr/velvetPrimary"
                android:textColor="?attr/velvetTextPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_bj_next_hand"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="@string/bj_btn_next_hand"
                android:textColor="?attr/velvetTextPrimary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
