<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/velvetBg"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mode_love_graph"
            android:textColor="?attr/velvetAccent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/mode_love_graph_desc"
            android:textColor="?attr/velvetTextMuted"
            android:textSize="12sp" />

        <!-- Bond score -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_velvet_glow"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_lg_score"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_lg_score_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?attr/velvetTextMuted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Constellation -->
        <com.velvet.couplesgame.ui.lovegraph.LoveGraphView
            android:id="@+id/lg_view"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tv_lg_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_velvet"
            android:gravity="center"
            android:padding="20dp"
            android:text="@string/love_graph_empty"
            android:textColor="?attr/velvetTextMuted"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Selected node detail -->
        <TextView
            android:id="@+id/tv_lg_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_velvet"
            android:lineSpacingExtra="3dp"
            android:padding="14dp"
            android:textColor="?attr/velvetTextPrimary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_lg_refresh"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/love_graph_refresh" />
    </LinearLayout>
</ScrollView>
