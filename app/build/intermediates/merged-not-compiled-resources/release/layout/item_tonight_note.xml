<?xml version="1.0" encoding="utf-8"?>
<!-- C 项 · 单日条目：默认折叠摘要，点击展开全文（隐私姿态：与 FLAG_SECURE 叙事一致） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_tn_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_velvet"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="48dp"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_tn_item_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/velvetAccent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_tn_item_mood"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="?attr/velvetTextMuted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_tn_item_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="?attr/velvetTextPrimary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_tn_item_full"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.25"
        android:textColor="?attr/velvetTextPrimary"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
