<?xml version="1.0" encoding="utf-8"?>
<!-- C 项 · 「今晚一句话」按日回看列表（架架规格 §3.5 第 3 层） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/velvetBg"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/tv_tnh_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="@string/tonight_note_history_title"
        android:textColor="?attr/velvetAccent"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_tnh_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:lineSpacingMultiplier="1.25"
        android:text="@string/tonight_note_empty_today"
        android:textColor="?attr/velvetTextMuted"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tnh_notes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never" />
</LinearLayout>
