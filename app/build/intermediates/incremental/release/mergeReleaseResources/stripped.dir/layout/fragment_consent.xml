<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/velvetBg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="@string/consent_title"
        android:textColor="?attr/velvetAccent"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Together vs Private Pass Mode Switcher -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mode_together"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/consent_mode_together"
            android:textColor="?attr/velvetTextPrimary"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mode_private"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/consent_mode_private"
            android:textColor="?attr/velvetAccent"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_consent_stage_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/consent_desc"
        android:textColor="?attr/velvetTextMuted"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_boundaries"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1" />

    <!--
      AUDIT-002 · 边界列表空状态（方案 A：零新增 string key）。
      复用 consent_title + consent_desc：后者本身就是行动指引
      （「点按任一方切换 YES / SOFT / HARD NO」），不是「暂无数据」式罗列。
      暖色丝绒卡片 + 衬线标题，避免列表空白带来的「页面坏了」错觉。
    -->
    <LinearLayout
        android:id="@+id/layout_consent_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card_velvet_glow"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="26dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="@string/consent_title"
            android:textColor="?attr/velvetAccent"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/consent_desc"
            android:textColor="?attr/velvetTextPrimary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Private Mode Anonymous Shield Summary -->
    <LinearLayout
        android:id="@+id/layout_private_summary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card_velvet_glow"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="26dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="@string/consent_private_shield_title"
            android:textColor="?attr/velvetAccent"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_private_summary_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:textColor="?attr/velvetTextPrimary"
            android:textSize="15sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_private_next_step"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="?attr/velvetPrimary"
        android:textColor="?attr/velvetTextPrimary"
        android:visibility="gone" />

</LinearLayout>
