<?xml version="1.0" encoding="utf-8"?>
<!--
  B 项 · 18+ 年龄确认（架架规格 §2.4）
  · 首启一次性门禁，必须早于任何成人向内容呈现
  · 文案不得含任何身体 / 动作 / 性暗示词（RED-A2 / A7）
  · decline 后就地切换为「仅保留基础玩法」说明，不锁死 App（软门禁）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/tv_agegate_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="@string/agegate_title"
        android:textColor="?attr/velvetAccent"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_agegate_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingMultiplier="1.25"
        android:text="@string/agegate_body"
        android:textColor="?attr/velvetTextPrimary"
        android:textSize="14sp" />

    <!-- Shown only after the user picks "under 18" -->
    <TextView
        android:id="@+id/tv_agegate_declined_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_velvet"
        android:lineSpacingMultiplier="1.22"
        android:padding="12dp"
        android:text="@string/agegate_declined_notice"
        android:textColor="?attr/velvetTextPrimary"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_agegate_decline_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.22"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/agegate_decline_note"
        android:textColor="?attr/velvetTextMuted"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
