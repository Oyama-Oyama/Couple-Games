<?xml version="1.0" encoding="utf-8"?>
<!--
  C 项 · 「今晚一句话」编辑弹窗（架架规格 §3.5 第 2 层 / §3.6）
  · 双方各一句 + 5 档心情标记
  · 同一天覆盖写；不提供导出 / 分享（安安 RED-A6 / RED-P）
  · 列表默认折叠摘要，需点击才展开全文
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="6dp"
    android:paddingEnd="22dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/tv_tn_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="@string/tonight_note_title"
        android:textColor="?attr/velvetAccent"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_tn_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingMultiplier="1.2"
        android:text="@string/tonight_note_subtitle"
        android:textColor="?attr/velvetTextMuted"
        android:textSize="12sp" />

    <!-- Partner A -->
    <TextView
        android:id="@+id/tv_tn_prompt_a"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/tonight_note_prompt"
        android:textColor="?attr/velvetTextPrimary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/et_tn_note_a"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card_velvet"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLength="140"
        android:minHeight="48dp"
        android:padding="12dp"
        android:textColor="?attr/velvetTextPrimary"
        android:textColorHint="?attr/velvetTextMuted"
        android:textSize="14sp" />

    <!-- Partner B -->
    <TextView
        android:id="@+id/tv_tn_prompt_b"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/tonight_note_prompt_b"
        android:textColor="?attr/velvetTextPrimary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/et_tn_note_b"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card_velvet"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLength="140"
        android:minHeight="48dp"
        android:padding="12dp"
        android:textColor="?attr/velvetTextPrimary"
        android:textColorHint="?attr/velvetTextMuted"
        android:textSize="14sp" />

    <!-- Mood -->
    <TextView
        android:id="@+id/tv_tn_mood_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/tonight_note_mood_label"
        android:textColor="?attr/velvetTextPrimary"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/rg_tn_mood"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_tn_mood_1"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:minWidth="48dp"
            android:text="@string/mood_1"
            android:textColor="?attr/velvetTextPrimary"
            android:textSize="12sp" />

        <RadioButton
            android:id="@+id/rb_tn_mood_2"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:minWidth="48dp"
            android:text="@string/mood_2"
            android:textColor="?attr/velvetTextPrimary"
            android:textSize="12sp" />

        <RadioButton
            android:id="@+id/rb_tn_mood_3"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:minWidth="48dp"
            android:text="@string/mood_3"
            android:textColor="?attr/velvetTextPrimary"
            android:textSize="12sp" />

        <RadioButton
            android:id="@+id/rb_tn_mood_4"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:minWidth="48dp"
            android:text="@string/mood_4"
            android:textColor="?attr/velvetTextPrimary"
            android:textSize="12sp" />

        <RadioButton
            android:id="@+id/rb_tn_mood_5"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:minWidth="48dp"
            android:text="@string/mood_5"
            android:textColor="?attr/velvetTextPrimary"
            android:textSize="12sp" />
    </RadioGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_tn_save"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="?attr/velvetPrimary"
        android:text="@string/tonight_note_save"
        android:textColor="?attr/velvetTextPrimary" />
</LinearLayout>
