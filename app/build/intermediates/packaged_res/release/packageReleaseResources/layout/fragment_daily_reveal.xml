<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/velvetBg"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mode_daily_reveal"
            android:textColor="?attr/velvetAccent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/mode_daily_reveal_desc"
            android:textColor="?attr/velvetTextMuted"
            android:textSize="12sp" />

        <!-- Step hint (whose turn / revealed) -->
        <TextView
            android:id="@+id/tv_reveal_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textColor="?attr/velvetAccent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- The question card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_velvet_glow"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tv_reveal_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_reveal_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="?attr/velvetTextMuted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Answer input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_reveal_answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/daily_reveal_answer_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_reveal_answer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="4"
                android:inputType="textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reveal_next"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:text="@string/daily_reveal_next"
            app:cornerRadius="24dp" />

        <!-- Both answers, shown after the handoff -->
        <LinearLayout
            android:id="@+id/layout_reveal_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_reveal_answer_a"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_velvet"
                android:padding="14dp"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_reveal_answer_b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_velvet"
                android:padding="14dp"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="14sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reveal_again"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:text="@string/daily_reveal_again"
            android:visibility="gone"
            style="@style/Widget.Material3.Button.OutlinedButton" />

    </LinearLayout>
</ScrollView>
