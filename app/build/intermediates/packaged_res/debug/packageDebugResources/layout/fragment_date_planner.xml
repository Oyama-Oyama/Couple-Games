<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/velvetBg"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mode_date_planner"
            android:textColor="?attr/velvetAccent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/mode_date_planner_desc"
            android:textColor="?attr/velvetTextMuted"
            android:textSize="12sp" />

        <!-- Stage banner: whose turn / result -->
        <TextView
            android:id="@+id/tv_dp_stage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="?attr/velvetAccent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progress_dp"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <!-- Candidate activity card -->
        <LinearLayout
            android:id="@+id/layout_dp_candidate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_velvet_glow"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tv_dp_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?attr/velvetAccent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_dp_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_dp_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:textColor="?attr/velvetTextMuted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_dp_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="?attr/velvetTextMuted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Vote buttons -->
        <LinearLayout
            android:id="@+id/layout_dp_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dp_pass"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/date_planner_pass" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dp_like"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/date_planner_like" />
        </LinearLayout>

        <!-- Result stage: agreed activities -->
        <LinearLayout
            android:id="@+id/layout_dp_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_dp_result_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_dp_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/date_planner_no_match"
                android:textColor="?attr/velvetTextMuted"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- One selectable row per agreed activity -->
            <RadioGroup
                android:id="@+id/rg_dp_matches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dp_next_step"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:text="@string/date_planner_confirm" />
        </LinearLayout>

        <!-- Schedule stage -->
        <LinearLayout
            android:id="@+id/layout_dp_schedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/date_planner_pick_date"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layout_dp_dates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_dp_custom_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/date_planner_custom_date_hint"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_dp_custom_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="date" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/date_planner_pick_slot"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_dp_slots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_dp_slot_evening"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/date_planner_slot_evening" />

                <RadioButton
                    android:id="@+id/rb_dp_slot_night"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/date_planner_slot_night" />

                <RadioButton
                    android:id="@+id/rb_dp_slot_day"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/date_planner_slot_day" />
            </RadioGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_dp_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/date_planner_note_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_dp_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="3"
                    android:inputType="textMultiLine" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dp_save"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:text="@string/date_planner_save" />
        </LinearLayout>

        <!-- Saved confirmation -->
        <LinearLayout
            android:id="@+id/layout_dp_saved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_velvet"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_dp_saved_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_dp_saved_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?attr/velvetTextMuted"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dp_restart"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="@string/date_planner_restart"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
