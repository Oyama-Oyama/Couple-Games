<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/velvetBg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_wheel_turn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:gravity="center"
        android:textColor="?attr/velvetAccent"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Mode Switcher -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mode_classic"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/wheel_mode_classic"
            android:textColor="?attr/velvetTextPrimary"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mode_desire"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/wheel_mode_desire"
            android:textColor="?attr/velvetTextPrimary"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mode_custom"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/wheel_mode_custom"
            android:textColor="?attr/velvetTextPrimary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Optional Custom Slice Input -->
    <LinearLayout
        android:id="@+id/layout_custom_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/et_wheel_option"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card_velvet"
            android:hint="@string/wheel_custom_hint"
            android:padding="10dp"
            android:textColor="?attr/velvetTextPrimary"
            android:textColorHint="?attr/velvetTextMuted"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_wheel_option"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="?attr/velvetPrimary"
            android:text="+"
            android:textColor="?attr/velvetTextPrimary" />
    </LinearLayout>

    <!-- Fixed 12 o'clock Pointer + Custom WheelView -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▼"
            android:textColor="?attr/velvetAccent"
            android:textSize="24sp" />

        <com.velvet.couplesgame.ui.wheel.WheelView
            android:id="@+id/wheel_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_wheel_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/wheel_ready_hint"
        android:textColor="?attr/velvetTextMuted"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_spin_wheel"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="?attr/velvetPrimary"
        android:text="@string/btn_spin_wheel"
        android:textColor="?attr/velvetTextPrimary"
        android:textSize="16sp" />
</LinearLayout>
