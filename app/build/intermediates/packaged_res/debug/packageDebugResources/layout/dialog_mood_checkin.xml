<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mood_how_feel"
            android:textColor="?attr/velvetTextPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_mood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_mood_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mood_1" />

            <RadioButton
                android:id="@+id/rb_mood_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mood_2" />

            <RadioButton
                android:id="@+id/rb_mood_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mood_3" />

            <RadioButton
                android:id="@+id/rb_mood_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mood_4" />

            <RadioButton
                android:id="@+id/rb_mood_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mood_5" />
        </RadioGroup>

        <!-- The label is filled at runtime with the partner's nickname. -->
        <TextView
            android:id="@+id/tv_gratitude_label_a"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="?attr/velvetTextPrimary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_gratitude_a"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_velvet"
            android:hint="@string/mood_gratitude_hint"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:padding="12dp"
            android:textColor="?attr/velvetTextPrimary"
            android:textColorHint="?attr/velvetTextMuted" />

        <!-- The label is filled at runtime with the partner's nickname. -->
        <TextView
            android:id="@+id/tv_gratitude_label_b"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="?attr/velvetTextPrimary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_gratitude_b"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_card_velvet"
            android:hint="@string/mood_gratitude_hint"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:padding="12dp"
            android:textColor="?attr/velvetTextPrimary"
            android:textColorHint="?attr/velvetTextMuted" />

    </LinearLayout>
</ScrollView>
