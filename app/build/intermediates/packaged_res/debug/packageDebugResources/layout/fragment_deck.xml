<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/velvetBg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="@string/deck_title"
        android:textColor="?attr/velvetAccent"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tab_custom"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/deck_tab_custom"
            android:textColor="?attr/velvetTextPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tab_favorites"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/deck_tab_favorites"
            android:textColor="?attr/velvetAccent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_custom_creator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/et_custom_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_velvet"
            android:hint="@string/hint_custom_prompt"
            android:minLines="2"
            android:padding="12dp"
            android:textColor="?attr/velvetTextPrimary"
            android:textColorHint="?attr/velvetTextMuted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="?attr/velvetPrimary"
            android:text="@string/btn_add_custom_card"
            android:textColor="?attr/velvetTextPrimary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_deck_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/deck_favorites_empty"
        android:textColor="?attr/velvetTextMuted"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_custom_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_favorite_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:visibility="gone" />
</LinearLayout>
