<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VelvetCouplesGame.Base" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">?attr/velvetBg</item>
        <item name="android:statusBarColor">?attr/velvetBg</item>
        <item name="android:navigationBarColor">?attr/velvetSurface</item>
        <item name="colorPrimary">?attr/velvetPrimary</item>
        <item name="colorOnPrimary">?attr/velvetTextPrimary</item>
        <item name="colorSecondary">?attr/velvetAccent</item>
        <item name="colorOnSecondary">?attr/velvetBg</item>
        <item name="colorSurface">?attr/velvetSurface</item>
        <item name="colorOnSurface">?attr/velvetTextPrimary</item>
    </style>

    <!-- Default Alias -->
    <style name="Theme.VelvetCouplesGame" parent="Theme.VelvetCouplesGame.VelvetNoir" />

    <!-- 1. Velvet Noir -->
    <style name="Theme.VelvetCouplesGame.VelvetNoir" parent="Theme.VelvetCouplesGame.Base">
        <item name="velvetBg">@color/velvet_bg</item>
        <item name="velvetSurface">@color/velvet_surface</item>
        <item name="velvetSurfaceElevated">@color/velvet_surface_elevated</item>
        <item name="velvetPrimary">@color/velvet_crimson</item>
        <item name="velvetAccent">@color/velvet_gold</item>
        <item name="velvetAccentStroke">@color/velvet_stroke</item>
        <item name="velvetTextPrimary">@color/velvet_ivory</item>
        <item name="velvetTextMuted">@color/velvet_muted</item>
    </style>

    <!-- 2. Blush Champagne -->
    <style name="Theme.VelvetCouplesGame.BlushChampagne" parent="Theme.VelvetCouplesGame.Base">
        <item name="velvetBg">@color/blush_bg</item>
        <item name="velvetSurface">@color/blush_surface</item>
        <item name="velvetSurfaceElevated">@color/blush_surface_elevated</item>
        <item name="velvetPrimary">@color/blush_primary</item>
        <item name="velvetAccent">@color/blush_accent</item>
        <item name="velvetAccentStroke">@color/blush_stroke</item>
        <item name="velvetTextPrimary">@color/blush_text</item>
        <item name="velvetTextMuted">@color/blush_muted</item>
    </style>

