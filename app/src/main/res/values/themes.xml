        <item name="velvetSurfaceElevated">@color/plum_surface_elevated</item>
        <item name="velvetPrimary">@color/plum_primary</item>
        <item name="velvetAccent">@color/plum_accent</item>
        <item name="velvetAccentStroke">@color/plum_stroke</item>
        <item name="velvetTextPrimary">@color/plum_text</item>
        <item name="velvetTextMuted">@color/plum_muted</item>
    </style>

    <!-- 4. Candlelight Amber -->
    <style name="Theme.VelvetCouplesGame.CandlelightAmber" parent="Theme.VelvetCouplesGame.Base">
        <item name="velvetBg">@color/amber_bg</item>
        <item name="velvetSurface">@color/amber_surface</item>
        <item name="velvetSurfaceElevated">@color/amber_surface_elevated</item>
