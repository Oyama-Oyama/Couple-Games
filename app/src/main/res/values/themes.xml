        <item name="velvetAccent">@color/amber_accent</item>
        <item name="velvetAccentStroke">@color/amber_stroke</item>
        <item name="velvetTextPrimary">@color/amber_text</item>
        <item name="velvetTextMuted">@color/amber_muted</item>
    </style>

