<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/velvetBg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Wallets -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_auction_chips_a"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_auction_chips_b"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="?attr/velvetAccent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Contract Lot Card -->
        <LinearLayout
            android:id="@+id/card_auction_contract"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_velvet_selected"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/tv_auction_tier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textColor="?attr/velvetAccent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_auction_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="serif"
                android:textColor="?attr/velvetAccent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_auction_soft_limit_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_card_velvet"
                android:padding="10dp"
                android:text="@string/soft_limit_warning"
                android:textColor="?attr/velvetAccent"
                android:textSize="13sp"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/check_auction_soft_limit_ack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/soft_limit_ack"
                android:textColor="?attr/velvetTextPrimary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_auction_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="serif"
                android:lineSpacingMultiplier="1.3"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_auction_bid_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_velvet"
                android:gravity="center"
                android:padding="12dp"
                android:textColor="?attr/velvetAccent"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_auction_turn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:textColor="?attr/velvetTextPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Bidding Controls -->
        <LinearLayout
            android:id="@+id/layout_auction_bidding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_bid_plus_5"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:backgroundTint="?attr/velvetPrimary"
                    android:text="+5 ✦"
                    android:textColor="?attr/velvetTextPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_bid_plus_15"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="?attr/velvetPrimary"
                    android:text="+15 ✦"
                    android:textColor="?attr/velvetTextPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_bid_all_in"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/auction_btn_all_in" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_bid_fold"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="@string/auction_btn_fold"
                android:textColor="?attr/velvetTextMuted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_auction_bailout"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/auction_btn_bailout"
                android:textColor="?attr/velvetAccent"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Sold / Execute Contract Stage -->
        <LinearLayout
            android:id="@+id/layout_auction_sold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_auction_save_voucher"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/reward_wallet_save"
                android:textColor="?attr/velvetAccent" />

            <TextView
                android:id="@+id/tv_auction_timer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?attr/velvetAccent"
                android:textSize="22sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_auction_timer"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_auction_next_lot"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="?attr/velvetPrimary"
                android:text="@string/auction_btn_next_lot"
                android:textColor="?attr/velvetTextPrimary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
