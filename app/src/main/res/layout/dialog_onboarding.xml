<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/velvetSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:text="@string/onboarding_title"
                android:textColor="?attr/velvetAccent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_step_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 / 2"
                android:textColor="?attr/velvetTextMuted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Step 1: Names & Inclusive Pronouns -->
        <LinearLayout
            android:id="@+id/layout_step_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_step1_desc"
                android:textColor="?attr/velvetTextMuted"
                android:textSize="13sp" />

            <TextView
                android:labelFor="@id/et_name_a"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/onboarding_partner_1"
                android:textColor="?attr/velvetAccent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_name_a"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_card_velvet"
                android:inputType="textPersonName"
                android:padding="12dp"
                android:textColor="?attr/velvetTextPrimary" />

            <Spinner
                android:id="@+id/spinner_pronoun_a"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:labelFor="@id/et_name_b"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/onboarding_partner_2"
                android:textColor="?attr/velvetAccent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_name_b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_card_velvet"
                android:inputType="textPersonName"
                android:padding="12dp"
                android:textColor="?attr/velvetTextPrimary" />

            <Spinner
                android:id="@+id/spinner_pronoun_b"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Step 2: Safe Word & Offline Privacy Promise -->
        <LinearLayout
            android:id="@+id/layout_step_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/onboarding_step2_promise"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="14sp" />

            <TextView
                android:labelFor="@id/et_safe_word"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/onboarding_safeword_label"
                android:textColor="?attr/velvetAccent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_safe_word"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card_velvet"
                android:inputType="text|textNoSuggestions"
                android:padding="12dp"
                android:textColor="?attr/velvetTextPrimary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_onboarding_back"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_back"
                android:textColor="?attr/velvetTextMuted" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_onboarding_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="?attr/velvetPrimary"
                android:text="@string/onboarding_continue"
                android:textColor="?attr/velvetTextPrimary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
