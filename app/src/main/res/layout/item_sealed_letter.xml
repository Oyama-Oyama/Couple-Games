<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_velvet"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_letter_row_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/velvetTextPrimary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_letter_row_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/velvetTextMuted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_letter_row_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_letter_row_action"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
