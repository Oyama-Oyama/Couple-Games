<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/velvetBg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Giver -> Receiver Role Banner + Swap Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_role_flow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:textColor="?attr/velvetAccent"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_swap_roles"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/cubes_btn_swap"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_wild_modifier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:checked="true"
            android:text="@string/cubes_wild_modifier_toggle"
            android:textColor="?attr/velvetTextMuted"
            android:textSize="12sp" />

        <!-- TOP CUBE: Action Block (Partner 1 taps) -->
        <com.velvet.couplesgame.ui.fatecubes.FateCubeCardView
            android:id="@+id/cube_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Sensual connector emblem between Top & Bottom Cubes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:text="×  ♥  ×"
            android:textColor="?attr/velvetAccent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- BOTTOM CUBE: Body Spot Block (Partner 2 taps) -->
        <com.velvet.couplesgame.ui.fatecubes.FateCubeCardView
            android:id="@+id/cube_spot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true" />

        <!-- Unlocked Combo Reveal + Bonus Twist + Built-in Countdown -->
        <LinearLayout
            android:id="@+id/card_combo_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_velvet_selected"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_combo_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:gravity="center"
                android:lineSpacingMultiplier="1.25"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_combo_soft_limit_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_card_velvet"
                android:padding="10dp"
                android:text="@string/soft_limit_warning"
                android:textColor="?attr/velvetAccent"
                android:textSize="13sp"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/check_combo_soft_limit_ack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/soft_limit_ack"
                android:textColor="?attr/velvetTextPrimary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_combo_modifier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="?attr/velvetAccent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_combo_timer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="?attr/velvetAccent"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_combo_timer"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_combo"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_favorite"
                    android:textColor="?attr/velvetAccent" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_next_round"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="?attr/velvetPrimary"
                android:text="@string/cubes_btn_next_round"
                android:textColor="?attr/velvetTextPrimary" />
        </LinearLayout>

        <!-- Spin Both Together Shortcut -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_spin_both"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:text="@string/cubes_btn_spin_both"
            android:textColor="?attr/velvetTextPrimary" />
    </LinearLayout>
</ScrollView>
