<?xml version="1.0" encoding="utf-8"?>
<!--
  A 项 · 引导式「约会夜」串场界面（架架规格 §1.7 / §5.4）
  · 顶部：4 段阶段指示 + 当前阶段名 + 阶段引导语
  · 中部：卡面区（tv_card_text 风格对齐 fragment_home.xml）
  · 底部：主行动按钮 + 安全暂停条（呼应既有 Safe Word / Pause，不得移除）
  · PEAK 阶段不设倒计时（主理人裁决），因此本页不包含任何计时控件
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_date_night"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/velvetBg"
    android:clipToPadding="false"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Stage title -->
        <TextView
            android:id="@+id/tv_dn_stage_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="@string/datenight_stage_warmup"
            android:textColor="?attr/velvetAccent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- 4-segment stage indicator -->
        <LinearLayout
            android:id="@+id/layout_dn_stage_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_dn_stage_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingTop="6dp"
                android:paddingEnd="2dp"
                android:paddingBottom="6dp"
                android:text="@string/datenight_stage_warmup"
                android:textColor="?attr/velvetAccent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_dn_stage_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingTop="6dp"
                android:paddingEnd="2dp"
                android:paddingBottom="6dp"
                android:text="@string/datenight_stage_deepen"
                android:textColor="?attr/velvetTextMuted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_dn_stage_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingTop="6dp"
                android:paddingEnd="2dp"
                android:paddingBottom="6dp"
                android:text="@string/datenight_stage_peak"
                android:textColor="?attr/velvetTextMuted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_dn_stage_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingTop="6dp"
                android:paddingEnd="2dp"
                android:paddingBottom="6dp"
                android:text="@string/datenight_stage_closing"
                android:textColor="?attr/velvetTextMuted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Stage prompt -->
        <TextView
            android:id="@+id/tv_dn_stage_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card_velvet"
            android:lineSpacingMultiplier="1.22"
            android:padding="12dp"
            android:text="@string/datenight_warmup_prompt"
            android:textColor="?attr/velvetTextMuted"
            android:textSize="13sp" />

        <!-- Card surface -->
        <LinearLayout
            android:id="@+id/layout_dn_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_velvet_glow"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tv_dn_card_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textColor="?attr/velvetAccent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_dn_soft_limit_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_card_velvet"
                android:padding="10dp"
                android:text="@string/soft_limit_warning"
                android:textColor="?attr/velvetAccent"
                android:textSize="13sp"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/check_dn_soft_limit_ack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/soft_limit_ack"
                android:textColor="?attr/velvetTextPrimary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_dn_card_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="serif"
                android:lineSpacingMultiplier="1.25"
                android:minHeight="66dp"
                android:text="@string/card_placeholder_hint"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="17sp" />

            <!--
              AC-807 #7：会话进行中隐藏「第 x/y 张」计数，去除任务面板感。
              阶段位置已由上方 4 段阶段指示与阶段间距收窄承载。
            -->
            <TextView
                android:id="@+id/tv_dn_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="?attr/velvetTextMuted"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Primary action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dn_primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="?attr/velvetPrimary"
            android:text="@string/datenight_enter"
            android:textColor="?attr/velvetTextPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dn_skip"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="@string/datenight_skip"
            android:textColor="?attr/velvetTextMuted" />

        <!-- Safe pause bar — must stay in place (Safe Word / Pause echo) -->
        <TextView
            android:id="@+id/tv_dn_safe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_card_velvet"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:text="@string/datenight_pause_safe"
            android:textColor="?attr/velvetTextMuted"
            android:textSize="13sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
