<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/velvetBg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/blind_match_subtitle"
        android:textColor="?attr/velvetTextMuted"
        android:textSize="13sp" />

    <!-- Swipe Stage with 2-Layer Depth Card Stack -->
    <LinearLayout
        android:id="@+id/layout_swipe_stage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_phase_banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/velvetTextPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress_blind_match"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:progressTint="?attr/velvetAccent" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="18dp"
            android:layout_weight="1"
            android:clipChildren="false">

            <!-- Underlying next-card depth layer -->
            <View
                android:id="@+id/card_stack_underlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.55"
                android:background="@drawable/bg_card_velvet"
                android:scaleX="0.93"
                android:scaleY="0.93"
                android:translationY="14dp" />

            <com.velvet.couplesgame.ui.blindmatch.SwipeableCardView
                android:id="@+id/swipe_card"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card_velvet_glow"
                android:padding="26dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_swipe_tier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:textAllCaps="true"
                        android:textColor="?attr/velvetAccent"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_swipe_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.25"
                        android:textColor="?attr/velvetTextPrimary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="@string/blind_match_swipe_hint"
                        android:textColor="?attr/velvetTextMuted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_badge_yes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:alpha="0"
                    android:text="@string/blind_match_stamp_yes"
                    android:textColor="@color/status_yes"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_badge_pass"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:alpha="0"
                    android:text="@string/blind_match_stamp_pass"
                    android:textColor="@color/status_hard_no"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </com.velvet.couplesgame.ui.blindmatch.SwipeableCardView>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pass"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="@string/btn_swipe_pass"
                android:textColor="?attr/velvetTextPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_yes"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:backgroundTint="?attr/velvetPrimary"
                android:text="@string/btn_swipe_yes"
                android:textColor="?attr/velvetTextPrimary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Reveal Stage -->
    <LinearLayout
        android:id="@+id/layout_reveal_stage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_reveal_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:textColor="?attr/velvetAccent"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_empty_reveal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/blind_match_no_matches"
            android:textColor="?attr/velvetTextMuted"
            android:textSize="14sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_match_results"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_play_board_with_matches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="?attr/velvetPrimary"
            android:text="@string/btn_play_board_with_matches"
            android:textColor="?attr/velvetTextPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_restart_blind_match"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_restart_blind_match"
            android:textColor="?attr/velvetTextPrimary" />
    </LinearLayout>

</LinearLayout>
