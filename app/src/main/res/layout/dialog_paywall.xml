<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/velvetSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="@string/paywall_title"
            android:textColor="?attr/velvetAccent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/paywall_subtitle"
            android:textColor="?attr/velvetTextMuted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/paywall_benefits"
            android:textColor="?attr/velvetTextPrimary"
            android:textSize="13sp" />

        <!-- Lifetime Plan (Highlighted for Android) -->
        <LinearLayout
            android:id="@+id/card_plan_lifetime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_velvet"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/paywall_plan_lifetime"
                    android:textColor="?attr/velvetAccent"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/paywall_plan_lifetime_desc"
                    android:textColor="?attr/velvetTextMuted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_price_lifetime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Annual Plan -->
        <LinearLayout
            android:id="@+id/card_plan_annual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_velvet"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/paywall_plan_annual"
                    android:textColor="?attr/velvetTextPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/paywall_plan_annual_desc"
                    android:textColor="?attr/velvetTextMuted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_price_annual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Weekly Date Night Pass -->
        <LinearLayout
            android:id="@+id/card_plan_weekly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_velvet"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/paywall_plan_weekly"
                    android:textColor="?attr/velvetTextPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/paywall_plan_weekly_desc"
                    android:textColor="?attr/velvetTextMuted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_price_weekly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_paywall_continue"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="?attr/velvetPrimary"
            android:text="@string/paywall_cta_unlock"
            android:textColor="?attr/velvetTextPrimary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_paywall_restore"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/paywall_restore"
                android:textColor="?attr/velvetAccent"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_paywall_close"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/paywall_not_now"
                android:textColor="?attr/velvetTextMuted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
