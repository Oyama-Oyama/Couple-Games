<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/velvetBg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Multi-Touch Hold Pad (Partner A) -->
    <TextView
        android:id="@+id/pad_partner_a"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="@drawable/bg_card_velvet"
        android:fontFamily="serif"
        android:gravity="center"
        android:textColor="?attr/velvetAccent"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Center Prompt + Pulsing Heartbeat Ring -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tv_heartbeat_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/velvetTextMuted"
            android:textSize="12sp" />

        <com.velvet.couplesgame.ui.heartbeat.PulseRingView
            android:id="@+id/pulse_ring"
            android:layout_width="156dp"
            android:layout_height="156dp"
            android:layout_marginTop="6dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tv_pulse_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:text="@string/heartbeat_ready_hint"
            android:textColor="?attr/velvetAccent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_heartbeat_soft_limit_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_card_velvet"
            android:padding="10dp"
            android:text="@string/soft_limit_warning"
            android:textColor="?attr/velvetAccent"
            android:textSize="13sp"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/check_heartbeat_soft_limit_ack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/soft_limit_ack"
            android:textColor="?attr/velvetTextPrimary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_heartbeat_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_velvet_glow"
            android:fontFamily="serif"
            android:gravity="center"
            android:lineSpacingMultiplier="1.25"
            android:padding="14dp"
            android:textColor="?attr/velvetTextPrimary"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_heartbeat_next_prompt"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="@string/heartbeat_btn_switch_prompt"
            android:textColor="?attr/velvetTextMuted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom Multi-Touch Hold Pad (Partner B) -->
    <TextView
        android:id="@+id/pad_partner_b"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="@drawable/bg_card_velvet"
        android:fontFamily="serif"
        android:gravity="center"
        android:textColor="?attr/velvetAccent"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
