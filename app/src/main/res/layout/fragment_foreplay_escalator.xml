<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/velvetBg"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_foreplay_lead"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:textColor="?attr/velvetAccent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_foreplay_swap"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/cubes_btn_swap"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="11sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_foreplay"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:progressTint="?attr/velvetAccent" />

        <LinearLayout
            android:id="@+id/card_foreplay_stage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_velvet_selected"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tv_foreplay_step_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:textAllCaps="true"
                android:textColor="?attr/velvetAccent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_foreplay_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="serif"
                android:textColor="?attr/velvetAccent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_foreplay_soft_limit_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_velvet"
                android:padding="10dp"
                android:text="@string/soft_limit_warning"
                android:textColor="?attr/velvetAccent"
                android:textSize="13sp"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/check_foreplay_soft_limit_ack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/soft_limit_ack"
                android:textColor="?attr/velvetTextPrimary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_foreplay_instruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="serif"
                android:lineSpacingMultiplier="1.35"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tv_foreplay_timer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="?attr/velvetAccent"
                android:textSize="26sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_foreplay_start_timer"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_foreplay_next"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="?attr/velvetPrimary"
            android:textColor="?attr/velvetTextPrimary"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
