<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/velvetBg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top HUD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_turn_indicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/velvetAccent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cycle_theme"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:textSize="12sp"
            android:textColor="?attr/velvetTextPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_rewards"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/btn_rewards_short"
            android:textColor="?attr/velvetAccent"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_player_a_pos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/velvetTextPrimary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_player_b_pos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="?attr/velvetAccent"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Dynamic 5-Theme 36-Tile Serpentine Canvas -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1">

        <com.velvet.couplesgame.ui.chess.BoardCanvasView
            android:id="@+id/board_canvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Status & Dice Controls -->
    <TextView
        android:id="@+id/tv_board_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/board_ready_hint"
        android:textColor="?attr/velvetTextMuted"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_dice_badge"
            android:layout_width="76dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_card_velvet"
            android:gravity="center"
            android:text="🎲 -"
            android:textColor="?attr/velvetAccent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_roll_dice"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:backgroundTint="?attr/velvetPrimary"
            android:text="@string/btn_roll_dice"
            android:textColor="?attr/velvetTextPrimary"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>
