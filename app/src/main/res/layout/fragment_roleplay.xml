<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/velvetBg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Scenario Browser -->
    <LinearLayout
        android:id="@+id/layout_rp_browser"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/roleplay_browser_subtitle"
            android:textColor="?attr/velvetTextMuted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_rp_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/msg_no_eligible_cards"
            android:textColor="?attr/velvetTextMuted"
            android:textSize="14sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_roleplay_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Active 3-Act Stage -->
    <ScrollView
        android:id="@+id/layout_rp_stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_rp_stage_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="serif"
                    android:textColor="?attr/velvetAccent"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_rp_swap_roles"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/cubes_btn_swap"
                    android:textColor="?attr/velvetTextPrimary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_rp_cast_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_velvet"
                android:padding="12dp"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="13sp" />

            <!-- Current Act Script Card -->
            <LinearLayout
                android:id="@+id/card_rp_act"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_velvet_selected"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:id="@+id/tv_rp_act_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:textAllCaps="true"
                    android:textColor="?attr/velvetAccent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_rp_soft_limit_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_velvet"
                    android:padding="10dp"
                    android:text="@string/soft_limit_warning"
                    android:textColor="?attr/velvetAccent"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <CheckBox
                    android:id="@+id/check_rp_soft_limit_ack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/soft_limit_ack"
                    android:textColor="?attr/velvetTextPrimary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_rp_direction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="?attr/velvetTextPrimary"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:letterSpacing="0.1"
                    android:text="@string/roleplay_whisper_label"
                    android:textAllCaps="true"
                    android:textColor="?attr/velvetTextMuted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_rp_whisper_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="serif"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="?attr/velvetAccent"
                    android:textSize="18sp"
                    android:textStyle="italic" />

                <TextView
                    android:id="@+id/tv_rp_timer_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:textColor="?attr/velvetAccent"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_rp_scene_timer"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_rp_next_act"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="?attr/velvetPrimary"
                android:textColor="?attr/velvetTextPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_rp_back_list"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/roleplay_btn_pick_another"
                android:textColor="?attr/velvetTextMuted" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
