<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/velvetBg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scratch_subtitle"
            android:textColor="?attr/velvetTextMuted"
            android:textSize="13sp" />

        <!-- Category Chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cat_all"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/scratch_cat_all"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cat_dare"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/scratch_cat_dare"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cat_location"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/scratch_cat_location"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cat_fantasy"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/scratch_cat_fantasy"
                android:textColor="?attr/velvetTextPrimary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_scratch_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="?attr/velvetAccent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_scratch_soft_limit_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_card_velvet"
            android:padding="10dp"
            android:text="@string/soft_limit_warning"
            android:textColor="?attr/velvetAccent"
            android:textSize="13sp"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/check_scratch_soft_limit_ack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/soft_limit_ack"
            android:textColor="?attr/velvetTextPrimary"
            android:visibility="gone" />

        <!-- Layered Scratch Card Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="10dp">

            <!-- Hidden Underneath Secret Card -->
            <LinearLayout
                android:id="@+id/card_scratch_underneath"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card_velvet_selected"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tv_scratch_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:textAllCaps="true"
                    android:textColor="?attr/velvetAccent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_scratch_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:textColor="?attr/velvetAccent"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_scratch_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.25"
                    android:textColor="?attr/velvetTextPrimary"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Rub-to-Scratch Metallic Foil Overlay -->
            <com.velvet.couplesgame.ui.scratch.ScratchCardView
                android:id="@+id/scratch_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/scratch_card_accessibility"
                android:focusable="true" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_scratch_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="?attr/velvetAccent"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_scratch_reveal_now"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:text="@string/btn_scratch_reveal_now"
            android:textColor="?attr/velvetTextPrimary" />

        <!-- Post-Reveal Action Controls -->
        <LinearLayout
            android:id="@+id/layout_scratch_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scratch_timer"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scratch_favorite"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_favorite"
                    android:textColor="?attr/velvetAccent" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_scratch_next"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="?attr/velvetPrimary"
                android:text="@string/btn_scratch_next"
                android:textColor="?attr/velvetTextPrimary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
