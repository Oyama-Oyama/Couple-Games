<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/velvetBg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_bomb_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/velvetTextMuted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_bomb_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:accessibilityLiveRegion="polite"
        android:fontFamily="serif"
        android:gravity="center"
        android:text="@string/bomb_idle_banner"
        android:textColor="?attr/velvetAccent"
        android:textSize="22sp"
        android:textStyle="bold" />

    <com.velvet.couplesgame.ui.heartbeat.PulseRingView
        android:id="@+id/bomb_pulse_view"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="14dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tv_bomb_relay_prompt"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card_velvet_glow"
        android:fontFamily="serif"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:padding="20dp"
        android:text="@string/bomb_ready_prompt"
        android:textColor="?attr/velvetTextPrimary"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tv_bomb_soft_limit_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_card_velvet"
        android:padding="10dp"
        android:text="@string/soft_limit_warning"
        android:textColor="?attr/velvetAccent"
        android:textSize="13sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_arm_bomb"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="?attr/velvetPrimary"
        android:text="@string/bomb_btn_arm"
        android:textColor="?attr/velvetTextPrimary"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_pass_bomb"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:backgroundTint="?attr/velvetPrimary"
        android:textColor="?attr/velvetTextPrimary"
        android:textSize="17sp"
        android:visibility="gone" />
</LinearLayout>
