<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.velvet.couplesgame.ui.home.HomeFragment"
        android:label="@string/nav_home">
        <action
            android:id="@+id/action_home_to_couple_board"
            app:destination="@id/nav_couple_board" />
        <action
            android:id="@+id/action_home_to_fate_cubes"
            app:destination="@id/nav_fate_cubes" />
        <action
            android:id="@+id/action_home_to_blind_match"
            app:destination="@id/nav_blind_match" />
        <action
            android:id="@+id/action_home_to_lucky_wheel"
            app:destination="@id/nav_lucky_wheel" />
        <action
            android:id="@+id/action_home_to_couple_mines"
            app:destination="@id/nav_couple_mines" />
        <action
            android:id="@+id/action_home_to_draw_guess"
            app:destination="@id/nav_draw_guess" />
        <action
            android:id="@+id/action_home_to_scratch"
            app:destination="@id/nav_scratch" />
        <action
            android:id="@+id/action_home_to_roleplay"
            app:destination="@id/nav_roleplay" />
        <action
            android:id="@+id/action_home_to_quiz"
            app:destination="@id/nav_quiz" />
        <action
            android:id="@+id/action_home_to_party_duel"
            app:destination="@id/nav_party_duel" />
        <action
            android:id="@+id/action_home_to_heartbeat"
            app:destination="@id/nav_heartbeat" />
        <action
            android:id="@+id/action_home_to_blackjack"
            app:destination="@id/nav_blackjack" />
        <action
            android:id="@+id/action_home_to_bomb"
            app:destination="@id/nav_bomb" />
        <action
            android:id="@+id/action_home_to_body_map"
            app:destination="@id/nav_body_map" />
        <action
            android:id="@+id/action_home_to_auction"
            app:destination="@id/nav_auction" />
        <action
            android:id="@+id/action_home_to_positions"
            app:destination="@id/nav_positions" />
        <action
            android:id="@+id/action_home_to_foreplay"
            app:destination="@id/nav_foreplay" />
        <action
            android:id="@+id/action_home_to_props"
            app:destination="@id/nav_props" />
        <action
            android:id="@+id/action_home_to_connect4"
            app:destination="@id/nav_connect4" />
        <action
            android:id="@+id/action_home_to_ladder"
            app:destination="@id/nav_ladder" />

        <!-- Social games: 12 modes share one host fragment, distinguished by modeId argument -->
        <action android:id="@+id/action_social_secret_mission" app:destination="@id/nav_social_game">
            <argument android:name="social_mode_id" app:argType="string" android:defaultValue="secret_mission" />
        </action>
        <action android:id="@+id/action_social_scenario_choice" app:destination="@id/nav_social_game">
            <argument android:name="social_mode_id" app:argType="string" android:defaultValue="scenario_choice" />
        </action>
        <action android:id="@+id/action_social_hot_seat" app:destination="@id/nav_social_game">
            <argument android:name="social_mode_id" app:argType="string" android:defaultValue="hot_seat" />
        </action>
        <action android:id="@+id/action_social_forfeit_wheel" app:destination="@id/nav_social_game">
            <argument android:name="social_mode_id" app:argType="string" android:defaultValue="forfeit_wheel" />
        </action>
        <action android:id="@+id/action_social_bucket_list" app:destination="@id/nav_social_game">
            <argument android:name="social_mode_id" app:argType="string" android:defaultValue="bucket_list" />
        </action>
        <action android:id="@+id/action_social_ldr_sync" app:destination="@id/nav_social_game">
            <argument android:name="social_mode_id" app:argType="string" android:defaultValue="ldr_sync" />
        </action>
        <action android:id="@+id/action_social_most_likely_to" app:destination="@id/nav_social_game">
            <argument android:name="social_mode_id" app:argType="string" android:defaultValue="most_likely_to" />
        </action>
        <action android:id="@+id/action_social_memory_lane" app:destination="@id/nav_social_game">
            <argument android:name="social_mode_id" app:argType="string" android:defaultValue="memory_lane" />
        </action>
        <action android:id="@+id/action_social_love_language" app:destination="@id/nav_social_game">
            <argument android:name="social_mode_id" app:argType="string" android:defaultValue="love_language" />
        </action>
        <action android:id="@+id/action_social_daily_question" app:destination="@id/nav_social_game">
            <argument android:name="social_mode_id" app:argType="string" android:defaultValue="daily_question" />
        </action>
        <action android:id="@+id/action_social_riddle_me" app:destination="@id/nav_social_game">
            <argument android:name="social_mode_id" app:argType="string" android:defaultValue="riddle_me" />
        </action>
        <action android:id="@+id/action_social_conversation_starter" app:destination="@id/nav_social_game">
            <argument android:name="social_mode_id" app:argType="string" android:defaultValue="conversation_starter" />
        </action>
        <action
            android:id="@+id/action_home_to_daily_reveal"
            app:destination="@id/nav_daily_reveal" />
        <action
            android:id="@+id/action_home_to_date_planner"
            app:destination="@id/nav_date_planner" />
        <action
            android:id="@+id/action_home_to_sealed_letter"
            app:destination="@id/nav_sealed_letter" />
        <action
            android:id="@+id/action_home_to_love_graph"
            app:destination="@id/nav_love_graph" />
        <!-- A 项 · 引导式约会夜（新增导航节点，不是新增游戏模式，不影响 36 模式计数） -->
        <action
            android:id="@+id/action_home_to_date_night"
            app:destination="@id/nav_date_night" />
        <!-- C 项 · 今晚一句话回看 -->
        <action
            android:id="@+id/action_home_to_tonight_note_history"
            app:destination="@id/nav_tonight_note_history" />
    </fragment>

    <fragment
        android:id="@+id/nav_fate_cubes"
        android:name="com.velvet.couplesgame.ui.fatecubes.FateCubesFragment"
        android:label="@string/mode_fate_cubes" />

    <fragment
        android:id="@+id/nav_couple_board"
        android:name="com.velvet.couplesgame.ui.chess.CoupleBoardFragment"
        android:label="@string/mode_chess" />

    <fragment
        android:id="@+id/nav_blind_match"
        android:name="com.velvet.couplesgame.ui.blindmatch.BlindMatchFragment"
        android:label="@string/mode_blind_match">
        <action
            android:id="@+id/action_blind_match_to_couple_board"
            app:destination="@id/nav_couple_board"
            app:popUpTo="@id/nav_blind_match"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/nav_lucky_wheel"
        android:name="com.velvet.couplesgame.ui.wheel.LuckyWheelFragment"
        android:label="@string/mode_wheel" />

    <fragment
        android:id="@+id/nav_couple_mines"
        android:name="com.velvet.couplesgame.ui.minesweeper.CoupleMinesFragment"
        android:label="@string/mode_minesweeper" />

    <fragment
        android:id="@+id/nav_draw_guess"
        android:name="com.velvet.couplesgame.ui.drawguess.DrawGuessFragment"
        android:label="@string/mode_draw_guess" />

    <fragment
        android:id="@+id/nav_scratch"
        android:name="com.velvet.couplesgame.ui.scratch.ScratchAdventureFragment"
        android:label="@string/mode_scratch" />

    <fragment
        android:id="@+id/nav_roleplay"
        android:name="com.velvet.couplesgame.ui.roleplay.RoleplayFragment"
        android:label="@string/mode_roleplay" />

    <fragment
        android:id="@+id/nav_quiz"
        android:name="com.velvet.couplesgame.ui.quiz.CoupleQuizFragment"
        android:label="@string/mode_quiz" />

    <fragment
        android:id="@+id/nav_party_duel"
        android:name="com.velvet.couplesgame.ui.duel.PartyDuelFragment"
        android:label="@string/mode_party_duel" />

    <fragment
        android:id="@+id/nav_heartbeat"
        android:name="com.velvet.couplesgame.ui.heartbeat.HeartbeatHoldFragment"
        android:label="@string/mode_heartbeat" />

    <fragment
        android:id="@+id/nav_blackjack"
        android:name="com.velvet.couplesgame.ui.blackjack.VelvetBlackjackFragment"
        android:label="@string/mode_blackjack" />

    <fragment
        android:id="@+id/nav_bomb"
        android:name="com.velvet.couplesgame.ui.bomb.VelvetBombFragment"
        android:label="@string/mode_bomb" />

    <fragment
        android:id="@+id/nav_body_map"
        android:name="com.velvet.couplesgame.ui.bodymap.BodyMapFragment"
        android:label="@string/mode_body_map" />

    <fragment
        android:id="@+id/nav_auction"
        android:name="com.velvet.couplesgame.ui.auction.DesireAuctionFragment"
        android:label="@string/mode_auction" />

    <fragment
        android:id="@+id/nav_positions"
        android:name="com.velvet.couplesgame.ui.positions.PositionsRouletteFragment"
        android:label="@string/mode_positions" />

    <fragment
        android:id="@+id/nav_foreplay"
        android:name="com.velvet.couplesgame.ui.foreplay.ForeplayEscalatorFragment"
        android:label="@string/mode_foreplay" />

    <fragment
        android:id="@+id/nav_props"
        android:name="com.velvet.couplesgame.ui.props.PropLabFragment"
        android:label="@string/mode_props" />

    <fragment
        android:id="@+id/nav_connect4"
        android:name="com.velvet.couplesgame.ui.connect4.NaughtyConnect4Fragment"
        android:label="@string/mode_connect4" />

    <fragment
        android:id="@+id/nav_ladder"
        android:name="com.velvet.couplesgame.ui.ladder.DesireLadderFragment"
        android:label="@string/mode_ladder" />

    <fragment
        android:id="@+id/nav_social_game"
        android:name="com.velvet.couplesgame.ui.social.SocialGameFragment"
        android:label="@string/mode_daily_question">
        <argument
            android:name="social_mode_id"
            app:argType="string"
            android:defaultValue="daily_question" />
    </fragment>

    <fragment
        android:id="@+id/nav_consent"
        android:name="com.velvet.couplesgame.ui.consent.ConsentFragment"
        android:label="@string/nav_consent" />

    <fragment
        android:id="@+id/nav_deck"
        android:name="com.velvet.couplesgame.ui.deck.DeckFragment"
        android:label="@string/nav_deck" />

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.velvet.couplesgame.ui.settings.SettingsFragment"
        android:label="@string/nav_settings" />

    <fragment
        android:id="@+id/nav_daily_reveal"
        android:name="com.velvet.couplesgame.ui.dailyreveal.DailyRevealFragment"
        android:label="@string/mode_daily_reveal" />

    <fragment
        android:id="@+id/nav_date_planner"
        android:name="com.velvet.couplesgame.ui.dateplanner.DatePlannerFragment"
        android:label="@string/mode_date_planner" />

    <fragment
        android:id="@+id/nav_sealed_letter"
        android:name="com.velvet.couplesgame.ui.letter.SealedLetterFragment"
        android:label="@string/mode_sealed_letter" />

    <fragment
        android:id="@+id/nav_love_graph"
        android:name="com.velvet.couplesgame.ui.lovegraph.LoveGraphFragment"
        android:label="@string/mode_love_graph" />

    <fragment
        android:id="@+id/nav_date_night"
        android:name="com.velvet.couplesgame.ui.session.DateNightFragment"
        android:label="@string/mode_date_night" />

    <fragment
        android:id="@+id/nav_tonight_note_history"
        android:name="com.velvet.couplesgame.ui.journal.TonightNoteHistoryFragment"
        android:label="@string/tonight_note_history_title" />
</navigation>
